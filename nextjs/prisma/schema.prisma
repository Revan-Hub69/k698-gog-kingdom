// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  password   String
  nickname   String   @unique
  isAdmin    Boolean  @default(false)
  kvkPackage String?  // 'gold' | 'silver' | 'bronze' | null
  castles    Castle[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Castle {
  id                  Int      @id @default(autoincrement())
  userId              Int
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  castleName          String
  currentPower        BigInt   @default(0)
  historicalMaxPower  BigInt   @default(0)
  totalHistoricalPower BigInt  @default(0)
  screenshotUrl       String?
  screenshotUpdatedAt DateTime?
  lastPowerUpdate     DateTime @default(now())
  rank                Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([userId, castleName])
  @@index([userId])
}

// KVK Package Distribution
model KvkEvent {
  id            Int         @id @default(autoincrement())
  name          String      // e.g. "KVK 30/08/2026"
  date          String      // display date string
  pack90Total   Int         @default(0)
  pack60Total   Int         @default(0)
  pack30Total   Int         @default(0)
  isActive      Boolean     @default(true)
  players       KvkPlayer[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model KvkPlayer {
  id          Int       @id @default(autoincrement())
  eventId     Int
  event       KvkEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  alliance    String?
  score       BigInt    @default(0)  // KVK score/points
  notes       String?
  pack90      Int       @default(0)
  pack60      Int       @default(0)
  pack30      Int       @default(0)
  under100m   Boolean   @default(false)
  pos         Int       @default(0)  // display position/rank
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([eventId])
}

// Farm Management
model Farm {
  id                  Int       @id @default(autoincrement())
  loginType           String    // "funplus" | "google"
  loginName           String    // account identifier
  castleName          String    // display name
  castleLevel         String    // e.g. "C40"
  m5Type              String    @default("no")   // "no" | "cavalry" | "ranged"
  m5Count             Int       @default(0)      // troop count if m5Type != "no"
  crystalForge        Boolean   @default(false)  // forgia per cristalli
  crystalForgeNote    String?                    // reason if false
  pelicano            Boolean   @default(false)  // has pelican setup
  pelicanoTroops      Int       @default(0)      // troops per pelican hit
  lastPelicanSent     DateTime?                  // last pellicanata data
  lastPelicanReceived DateTime?                  // last pellicanata subita
  nwDone              Boolean   @default(false)  // NW event completed
  hospitalCapacity    Int       @default(0)      // hospital capacity
  notes               String?                   // free notes
  sortOrder           Int       @default(0)      // manual sort
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}
