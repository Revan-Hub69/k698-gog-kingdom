// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  password   String
  nickname   String   @unique
  isAdmin    Boolean  @default(false)
  kvkPackage String?  // 'gold' | 'silver' | 'bronze' | null
  castles    Castle[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Castle {
  id                  Int      @id @default(autoincrement())
  userId              Int
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  castleName          String
  currentPower        BigInt   @default(0)
  historicalMaxPower  BigInt   @default(0)
  totalHistoricalPower BigInt  @default(0)
  screenshotUrl       String?
  screenshotUpdatedAt DateTime?
  lastPowerUpdate     DateTime @default(now())
  rank                Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([userId, castleName])
  @@index([userId])
}

// KVK Package Distribution
model KvkEvent {
  id            Int         @id @default(autoincrement())
  name          String      // e.g. "KVK 30/08/2026"
  date          String      // display date string
  pack90Total   Int         @default(0)
  pack60Total   Int         @default(0)
  pack30Total   Int         @default(0)
  isActive      Boolean     @default(true)
  players       KvkPlayer[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model KvkPlayer {
  id          Int       @id @default(autoincrement())
  eventId     Int
  event       KvkEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  alliance    String?
  score       BigInt    @default(0)  // KVK score/points
  notes       String?
  pack90      Int       @default(0)
  pack60      Int       @default(0)
  pack30      Int       @default(0)
  under100m   Boolean   @default(false)
  pos         Int       @default(0)  // display position/rank
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([eventId])
}

// Farm Management
model Farm {
  id                  Int       @id @default(autoincrement())
  loginType           String    // "funplus" | "google"
  loginName           String
  castleName          String
  castleLevel         String    // e.g. "C40"
  m5Cavalry           Int       @default(0)  // cavalry M5 count, 0 = none
  m5Ranged            Int       @default(0)  // ranged M5 count, 0 = none
  crystalForge        Boolean   @default(false)
  crystalForgeNote    String?
  pelicano            Boolean   @default(false)
  pelicanoTroops      Int       @default(0)
  lastPelicanSent     DateTime?
  lastPelicanReceived DateTime?
  nwLastDone          DateTime? // timestamp of when NW was marked done
  nwOptimized         Boolean   @default(false)  // NW castle optimization
  talentoCura         Boolean   @default(false)  // talento cura da assegnare
  hospitalCapacity    Int       @default(0)
  notes               String?
  sortOrder           Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// Migration Power Submissions (no auth required)
model MigrationSubmission {
  id           Int      @id @default(autoincrement())
  playerName   String
  position     String   // position in kingdom, e.g. "1234"
  power        String   // power as string to preserve formatting
  screenshots  String[] // base64 or URLs, array
  notes        String?
  createdAt    DateTime @default(now())
}
